# Bench utilities that run inside the bench Docker network:
# seeding (bench-data), the PostgreSQL sampler, verification/reporting and the
# environment report. PostgreSQL is not published on the host, so these tools
# never connect to localhost:5432.
FROM golang:1.23-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN for tool in bench-data bench-sampler bench-verify bench-environment; do \
      CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/$tool ./cmd/$tool || exit 1; \
    done

FROM alpine:3.20

RUN apk --no-cache add ca-certificates

COPY --from=builder /out/ /usr/local/bin/

ENTRYPOINT []
CMD ["bench-verify"]
